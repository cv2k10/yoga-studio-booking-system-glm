{
  "name": "sattva-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && concurrently -k -n css,worker \"npm:watch:css\" \"wrangler dev --port 3000\"",
    "build:css": "tailwindcss -i src/styles/globals.css -o public/styles.css --minify",
    "watch:css": "tailwindcss -i src/styles/globals.css -o public/styles.css --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply sattva --local",
    "db:seed": "node --no-warnings scripts/seed.mjs && wrangler d1 execute sattva --local --file=scripts/seed.sql",
    "deploy": "npm run build:css && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.13.13",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@tailwindcss/cli": "4.1.17",
    "@types/qrcode": "1.5.6",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wrangler": "4.151.0"
  }
}
